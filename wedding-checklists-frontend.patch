+++ b/src/app/pages/sa/_wedding-shared.scss
@@ -0,0 +1,320 @@
+// Shared look for the wedding pages (checklists + family & contacts).
+// Matches the Notes page: editor-style form on the left, cards on the right.
+$mobile: 768px;
+
+.page {
+  max-width: 1400px;
+  margin: 3rem auto;
+  padding: 0 clamp(1rem, 4vw, 3rem);
+}
+
+.page-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: 1rem;
+  margin-bottom: 1.5rem;
+
+  h1 {
+    margin: 0;
+    font-size: 2rem;
+    color: var(--neutral-color);
+  }
+}
+
+.page-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  margin-top: 0.4rem;
+  font-size: 0.95rem;
+  color: var(--accent-color);
+
+  a {
+    color: var(--accent-color);
+    text-decoration: none;
+
+    &:hover { color: var(--neutral-color); text-decoration: underline; }
+  }
+}
+
+// Toggle button only exists on phones
+.add-toggle { display: none; }
+
+.layout {
+  display: grid;
+  grid-template-columns: minmax(300px, 400px) 1fr;
+  gap: 2.5rem;
+  align-items: start;
+}
+
+.side-form {
+  position: sticky;
+  top: 8rem;
+
+  app-code-window { margin-bottom: 0; }
+}
+
+// ============ Form inside the editor window ============
+// Line numbers come from a CSS counter, so rows that appear and disappear stay numbered in order.
+.editor-form {
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  margin-top: 0.25rem;
+  padding-bottom: 0.25rem;
+  font-family: monospace, monospace;
+  counter-reset: line 2; // the code window already shows two lines
+}
+
+.editor-row {
+  display: flex;
+  align-items: flex-start;
+  border-left: 3px solid transparent;
+
+  &:focus-within {
+    background: color-mix(in srgb, var(--neutral-color) 6%, transparent);
+    border-left-color: color-mix(in srgb, var(--neutral-color) 30%, transparent);
+
+    .editor-row__number { color: var(--neutral-color); }
+  }
+
+  &__number {
+    flex-shrink: 0;
+    width: 2.5rem;
+    padding: 0.3rem 0.85rem 0 0;
+    text-align: right;
+    font-size: 0.75rem;
+    color: color-mix(in srgb, var(--accent-color) 70%, transparent);
+    user-select: none;
+
+    &::before {
+      counter-increment: line;
+      content: counter(line);
+    }
+  }
+
+  &__content {
+    flex: 1;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    gap: 0.35rem;
+    padding: 0.25rem 0.85rem 0.35rem 0;
+
+    > .btn { width: 100%; }
+  }
+
+  &__code {
+    font-size: 0.95rem;
+    color: var(--neutral-color);
+  }
+}
+
+.tok-keyword { color: var(--accent-color); font-weight: 700; }
+.tok-punct { color: var(--accent-color); }
+
+.editor-field {
+  box-sizing: border-box;
+  width: 100%;
+  padding: 0.5rem 0.65rem;
+  font: inherit;
+  font-size: 0.9rem;
+  color: var(--neutral-color);
+  background: color-mix(in srgb, #000 20%, transparent);
+  border: 1px solid color-mix(in srgb, var(--accent-color) 50%, transparent);
+  border-radius: 6px;
+  caret-color: var(--neutral-color);
+  transition: border-color 0.2s;
+  color-scheme: dark;
+
+  &::placeholder { color: color-mix(in srgb, var(--neutral-color) 45%, transparent); }
+  &:hover { border-color: var(--accent-color); }
+  &:focus { outline: none; border-color: var(--neutral-color); }
+  &:focus-visible { outline: 2px solid var(--neutral-color); outline-offset: 2px; }
+}
+
+select.editor-field option { background: var(--secondary-color); color: var(--neutral-color); }
+
+textarea.editor-field {
+  height: 90px;
+  min-height: 60px;
+  resize: vertical;
+  line-height: 1.6;
+}
+
+.hint {
+  font-size: 0.8rem;
+  color: color-mix(in srgb, var(--neutral-color) 65%, transparent);
+
+  a { color: var(--accent-color); }
+}
+
+.editing-banner {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin: 0 0.85rem 0.25rem 2.5rem;
+  padding: 0.35rem 0.6rem;
+  font-size: 0.85rem;
+  color: var(--primary-color);
+  background: var(--accent-color);
+  border-radius: 6px;
+
+  .btn--ghost { color: var(--primary-color); padding: 0.2rem 0.5rem; }
+}
+
+// ============ Toggles, chips, toolbar ============
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.75rem 1rem;
+  margin-bottom: 1rem;
+
+  &__select select {
+    padding: 0.4rem 0.6rem;
+    font: inherit;
+    font-size: 0.9rem;
+    color: var(--neutral-color);
+    background: var(--secondary-color);
+    border: 1px solid color-mix(in srgb, var(--accent-color) 50%, transparent);
+    border-radius: 6px;
+  }
+}
+
+.chips { display: flex; gap: 0.4rem; flex-wrap: wrap; }
+
+.chip {
+  padding: 0.35rem 0.85rem;
+  font: inherit;
+  font-size: 0.85rem;
+  color: var(--neutral-color);
+  background: transparent;
+  border: 1px solid color-mix(in srgb, var(--accent-color) 50%, transparent);
+  border-radius: 999px;
+  cursor: pointer;
+
+  &:hover { border-color: var(--neutral-color); }
+
+  &.is-active {
+    color: var(--primary-color);
+    background: var(--neutral-color);
+    border-color: var(--neutral-color);
+  }
+
+  &:focus-visible { outline: 2px solid var(--neutral-color); outline-offset: 2px; }
+}
+
+.toggle {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.45rem;
+  font-size: 0.9rem;
+  cursor: pointer;
+
+  input { accent-color: var(--accent-color); width: 1rem; height: 1rem; }
+}
+
+// ============ Cards ============
+.card {
+  background-color: var(--secondary-color);
+  border: 1px solid color-mix(in srgb, var(--accent-color) 40%, transparent);
+  border-left: 4px solid var(--neutral-color);
+  border-radius: 10px;
+  padding: 1rem 1.1rem;
+}
+
+.icon-btn {
+  padding: 0.3rem 0.45rem;
+  font-size: 1.1rem;
+  line-height: 1;
+  color: var(--neutral-color);
+  background: none;
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  opacity: 0.65;
+  transition: opacity 0.2s, background-color 0.2s;
+
+  &:hover:not(:disabled) {
+    opacity: 1;
+    background-color: color-mix(in srgb, var(--neutral-color) 10%, transparent);
+  }
+
+  &:disabled { opacity: 0.3; cursor: wait; }
+
+  &:focus-visible { opacity: 1; outline: 2px solid var(--neutral-color); outline-offset: 2px; }
+}
+
+.tag {
+  display: inline-block;
+  padding: 0.1rem 0.55rem;
+  font-size: 0.78rem;
+  color: var(--accent-color);
+  border: 1px solid color-mix(in srgb, var(--accent-color) 50%, transparent);
+  border-radius: 999px;
+}
+
+.muted { color: color-mix(in srgb, var(--neutral-color) 60%, transparent); }
+
+.empty-state {
+  padding: 2rem 0;
+  font-size: 1rem;
+  text-align: center;
+  color: var(--accent-color);
+
+  p { margin: 0 0 1rem; }
+}
+
+// ============ Messages ============
+.error,
+.success {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 1rem;
+  margin-bottom: 1.25rem;
+  padding: 0.6rem 0.9rem;
+  font-size: 1rem;
+  border-radius: 6px;
+  border-left: 3px solid currentColor;
+}
+
+.error { color: #F43F5E; background-color: rgba(232, 165, 152, 0.1); }
+.success { color: #10B981; background-color: rgba(181, 201, 154, 0.1); }
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+// ============ Phones ============
+@media (max-width: $mobile) {
+  .page { margin: 2rem auto; }
+
+  .add-toggle { display: inline-flex; flex-shrink: 0; }
+
+  .page-links {
+    flex-direction: column;
+    gap: 0.2rem;
+
+    span { display: none; }
+  }
+
+  .layout { grid-template-columns: 1fr; gap: 1.5rem; }
+
+  .side-form {
+    display: none;
+    position: static;
+
+    &.is-open { display: block; }
+  }
+}
