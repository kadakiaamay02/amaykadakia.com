+}
+
+export interface GuestFlightInput {
+  guest_name: string;
+  event: ChecklistKey;
+  flight: string;
+  flight_date: string;
+  day_start_ts: number;
+  arrive_time: string | null;
+  arrive_ts: number | null;
+  from_airport: string | null;
+  to_airport: string | null;
+  pickup_by: string | null;
+  notes: string | null;
+  auto_pin: boolean;
+}
+
+export interface GuestFlightsResponse {
+  flights: GuestFlight[];
+  pinned: string[];
+  max_pinned: number;
